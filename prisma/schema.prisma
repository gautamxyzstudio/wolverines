  updatedAt             DateTime @updatedAt
}

model Event {
  id        String   @id @default(cuid())

  date      DateTime @db.Date
  location  String

  startTime DateTime @db.Time
  endTime   DateTime @db.Time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id               String   @id @default(cuid())

  title            String
  content          String
  featuredImage    String?
  featuredImageData Bytes?
  featuredImageType String?
  metaTitle        String?
  metaDescription  String?
  slug             String   @unique
  date             DateTime @db.Date
  shortDescription String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum DonationPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DonationAcknowledgement {
  ACKNOWLEDGE
  ANONYMOUS
}

model PendingDonation {
  id                     String   @id @default(cuid())

  donorName              String
  email                  String

  countryCode            String
  contactNumber          String

  amount                 Decimal  @db.Decimal(10, 2)
  currency               String   @default("CAD")

  acknowledgement       DonationAcknowledgement

  paymentStatus          DonationPaymentStatus @default(PENDING)
  stripeCheckoutSessionId String? @unique

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Donation {
  id                     String   @id @default(cuid())

  donorName              String
  email                  String

  countryCode            String
  contactNumber          String

  amount                 Decimal  @db.Decimal(10, 2)
  currency               String   @default("CAD")

  acknowledgement       DonationAcknowledgement

  paymentStatus          DonationPaymentStatus @default(PAID)
  stripeCheckoutSessionId String? @unique

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model JoinOurClub {
  id                       String   @id @default(cuid())

  childName                String
  dateOfBirth              DateTime @db.Date
  gender                   String

  parentGuardianName       String
  relationToChild          String

  email                    String
  countryCode              String
  contactNumber            String

  message                  String

  secondaryCountryCode     String?
  secondaryContactNumber   String?
  secondaryRelationToChild String?

  address                  String?
  city                     String?
  postalCode               String?
  country                  String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model EmailContact {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EmailSendStatus {
  SENT
  FAILED
  PARTIAL
}

enum EmailRecipientSource {
  DATABASE
  CSV
  DIRECT
}

model EmailHistory {
  id              String               @id @default(cuid())
  recipients      Json
  failedRecipients Json?
  subject         String
  htmlContent     String
  source          EmailRecipientSource
  status          EmailSendStatus
  totalRecipients Int
  sentCount       Int                  @default(0)
  failedCount     Int                  @default(0)
  errorMessage    String?
  sentAt          DateTime             @default(now())
  createdAt       DateTime             @default(now())
}