// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactUs {
  id            String   @id @default(cuid())
  fullName      String
  countryCode   String
  contactNumber String
  email         String
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("Registration")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SummerPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model PendingSummerCampRegistration {
  id                     String   @id @default(cuid())
  registrationId         String   @unique
  parentGuardianName     String
  relationToChild        String

  email                  String
  countryCode            String
  contactNumber          String

  secondaryCountryCode   String?
  secondaryContactNumber String?

  address                String?
  city                   String?
  postalCode             String?
  country                String?
  message                String?

  children               Json

 subtotal               Decimal @db.Decimal(10, 2)
 siblingDiscount        Decimal @default(0) @db.Decimal(10, 2)
 processingFee          Decimal @default(0) @db.Decimal(10, 2)
 totalAmount            Decimal @db.Decimal(10, 2)

  paymentStatus          SummerPaymentStatus @default(PENDING)
  stripeCheckoutSessionId  String? @unique

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SummerCampRegistration {
  id                     String   @id @default(cuid())
  registrationId         String   @unique
  parentGuardianName     String
  relationToChild        String

  email                  String
  countryCode            String
  contactNumber          String

  secondaryCountryCode   String?
  secondaryContactNumber String?

  address                String?
  city                   String?
  postalCode             String?
  country                String?
  message                String?

  children               Json

  subtotal               Decimal @db.Decimal(10, 2)
  siblingDiscount        Decimal @default(0) @db.Decimal(10, 2)
  processingFee          Decimal @default(0) @db.Decimal(10, 2)
  totalAmount            Decimal @db.Decimal(10, 2)

  paymentStatus          SummerPaymentStatus @default(PAID)
  stripeCheckoutSessionId  String? @unique

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SummerCampPricing {
  id                    String   @id @default(cuid())

  minAge                Int
  maxAge                Int

  youngerAgePrice       Decimal @db.Decimal(10, 2)
  olderAgePrice         Decimal @db.Decimal(10, 2)

  siblingDiscount       Decimal @default(40) @db.Decimal(10, 2)
  processingFeePercent  Decimal @default(3) @db.Decimal(5, 2)

  isEnabled             Boolean @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

